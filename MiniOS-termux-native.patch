+  chmod 755 "$backup/generated/$HELPER_REL"
+  chmod 644 "$backup/generated/$PANEL_REL" "$backup/generated/$TERMINAL_REL" \
+    "$backup/generated/$FILES_REL" "$backup/generated/$BROWSER_REL"
